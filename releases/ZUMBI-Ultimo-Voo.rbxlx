  <Item class="ServerScriptService" referent="RBX6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX7">
      <Properties>
        <string name="Name">ZumbiServer</string>
      </Properties>
      <Item class="Script" referent="RBX8">
        <Properties>
          <string name="Name">Boot</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
Players.CharacterAutoLoads = false

local Util = require(script.Parent.Util)
local network = Util.folder(ReplicatedStorage, "ZumbiNetwork")
local remotes = {}
for _, name in { "Fire", "Reload", "Action", "Effects" } do
	local remote = Instance.new("RemoteEvent")
	remote.Name, remote.Parent = name, network
	remotes[name] = remote
end
local state = Util.folder(ReplicatedStorage, "ZumbiState")
require(script.Parent.GameService).start(remotes, state)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9">
        <Properties>
          <string name="Name">CombatService</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local Balance = require(game.ReplicatedStorage.ZumbiShared.Balance)
local Util = require(script.Parent.Util)
local Zombies = require(script.Parent.ZombieService)

local Combat = { Inventory = {}, Effects = nil }
local rng = Random.new()

local function sync(record)
	if not record.tool.Parent then return end
	record.tool:SetAttribute("Ammo", record.ammo)
	record.tool:SetAttribute("Reserve", record.reserve)
	record.tool:SetAttribute("Tier", record.tier)
	record.tool:SetAttribute("Reloading", record.reloading)
end

local function equipped(player)
	local list = Combat.Inventory[player]
	local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
	return tool and list and list[tool:GetAttribute("WeaponId")]
end

function Combat.recolor(player)
	local skin = Balance.Skins[player:GetAttribute("Skin") or "Default"] or Balance.Skins.Default
	for _, record in Combat.Inventory[player] or {} do
		local panel = record.tool:FindFirstChild("Acabamento")
		if panel then panel.Color = Color3.fromRGB(table.unpack(skin.Color)) end
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local trail = root:FindFirstChild("ZumbiTrail")
	if player:GetAttribute("Skin") == "Default" then
		if trail then trail.Enabled = false end
		return
	end
	if not trail then
		local a, b = Instance.new("Attachment"), Instance.new("Attachment")
		a.Name, b.Name, a.Position, b.Position = "TrailTop", "TrailBottom", Vector3.new(0, 0.4, 0.6), Vector3.new(0, -0.7, 0.6)
		a.Parent, b.Parent = root, root
		trail = Instance.new("Trail")
		trail.Name, trail.Attachment0, trail.Attachment1 = "ZumbiTrail", a, b
		trail.Lifetime, trail.MinLength, trail.LightEmission = 0.22, 0.2, 0.45
		trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		trail.Parent = root
	end
	trail.Color, trail.Enabled = ColorSequence.new(Color3.fromRGB(table.unpack(skin.Color))), true
end

function Combat.give(player, id)
	local def = Balance.Weapons[id]
	if not def or not player.Character or not player:FindFirstChild("Backpack") then return false end
	local list = Combat.Inventory[player] or {}; Combat.Inventory[player] = list
	if list[id] and list[id].tool.Parent then Combat.refill(player, id, true); return true end
	local tool = Instance.new("Tool")
	tool.Name, tool.CanBeDropped, tool.RequiresHandle = def.Name, false, true
	tool:SetAttribute("WeaponId", id)
	tool.Grip = CFrame.new(0, -0.15, 0.2) * CFrame.Angles(0, 0, 0)
	local function gunpart(name, size, offset, color)
		local p = Instance.new("Part"); p.Name, p.Size, p.Color = name, size, color
		p.CanCollide, p.CanTouch, p.CanQuery, p.Massless, p.Material = false, false, false, true, Enum.Material.Metal
		p.CFrame, p.Parent = offset, tool
		return p
	end
	local handle = gunpart("Handle", Vector3.new(0.35, 0.85, 0.4), CFrame.identity, Color3.fromRGB(40, 43, 47))
	local length = if id == "Pistol" then 1.4 elseif id == "Shotgun" then 3.2 else 2.6
	for _, spec in {
		{ "Corpo", Vector3.new(0.55, 0.55, length), CFrame.new(0, 0.45, -length / 2 + 0.3), Color3.fromRGB(47, 52, 57) },
		{ "Acabamento", Vector3.new(0.57, 0.2, length * 0.6), CFrame.new(0, 0.65, -length / 2 + 0.3), Color3.fromRGB(table.unpack(def.Color)) },
		{ "Cano", Vector3.new(0.22, 0.22, 0.6), CFrame.new(0, 0.45, -length + 0.1), Color3.fromRGB(22, 24, 28) },
	} do
		local p = gunpart(table.unpack(spec))
		local weld = Instance.new("WeldConstraint"); weld.Part0, weld.Part1, weld.Parent = handle, p, p
	end
	local muzzle = Instance.new("Attachment"); muzzle.Name, muzzle.Position, muzzle.Parent = "Muzzle", Vector3.new(0, 0.45, -length - 0.2), handle
	local record = { tool = tool, id = id, ammo = def.Magazine, reserve = def.Reserve, tier = 0, reloading = false, nextShot = 0 }
	list[id] = record
	sync(record)
	tool.Parent = player.Backpack
	Combat.recolor(player)
	local _, hum = Util.alive(player)
	if hum then hum:EquipTool(tool) end
	return true
end

function Combat.clear(player)
	for _, record in Combat.Inventory[player] or {} do record.tool:Destroy() end
	Combat.Inventory[player] = {}
end

function Combat.refill(player, id, full)
	local record = if id then (Combat.Inventory[player] or {})[id] else equipped(player)
	if not record or not record.tool.Parent then return false end
	local def = Balance.Weapons[record.id]
	record.reserve = math.min(def.Reserve, record.reserve + (if full then def.Reserve else math.ceil(def.Reserve * 0.35)))
	if full then record.ammo = def.Magazine end
	sync(record)
	return true
end

function Combat.owned(player, id)
	local record = (Combat.Inventory[player] or {})[id]
	return record and record.tool.Parent ~= nil
end

function Combat.upgrade(player)
	local record = equipped(player)
	if not record or record.tier &gt;= 3 then return false end
	record.tier += 1
	record.ammo, record.reserve = Balance.Weapons[record.id].Magazine, Balance.Weapons[record.id].Reserve
	record.tool.Name = Balance.Weapons[record.id].Name .. " +" .. record.tier
	sync(record)
	return true
end

function Combat.canUpgrade(player)
	local record = equipped(player)
	return record and record.tier &lt; 3
end

function Combat.hasEquipped(player) return equipped(player) ~= nil end

function Combat.reload(player)
	local record = equipped(player)
	if not record or not Util.alive(player) or not player:GetAttribute("InRound") then return end
	local def = Balance.Weapons[record.id]
	if record.reloading or record.ammo &gt;= def.Magazine or record.reserve &lt;= 0 then return end
	record.reloading = true
	sync(record)
	local duration = def.Reload * (if player:GetAttribute("QuickHands") then 0.65 else 1)
	task.delay(duration, function()
		if not record.tool.Parent then return end
		local load = math.min(def.Magazine - record.ammo, record.reserve)
		record.ammo += load; record.reserve -= load; record.reloading = false
		sync(record)
	end)
end

function Combat.fire(player, aim)
	if not Util.finiteVector(aim) or not player:GetAttribute("InRound") then return end
	local alive, _, root = Util.alive(player)
	local record = equipped(player)
	if not alive or not record or record.tool.Parent ~= player.Character or record.reloading then return end
	local def = Balance.Weapons[record.id]
	local now = os.clock()
	if now &lt; record.nextShot or record.ammo &lt; 1 then return end
	local head = player.Character:FindFirstChild("Head")
	local origin = if head then head.Position else root.Position + Vector3.new(0, 1.5, 0)
	local delta = aim - origin
	if delta.Magnitude &lt; 1 then return end
	record.nextShot = now + def.Interval * 0.95
	record.ammo -= 1
	sync(record)
	local base = delta.Unit
	local basis = CFrame.lookAt(Vector3.zero, base)
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	for _, p in Players:GetPlayers() do if p.Character then table.insert(ignore, p.Character) end end
	local drops = workspace:FindFirstChild("ZumbiDrops"); if drops then table.insert(ignore, drops) end
	params.FilterDescendantsInstances = ignore
	local hits, anyHit, headshot = {}, false, false
	local segments = {}
	for _ = 1, def.Pellets do
		local direction = (base + basis.RightVector * rng:NextNumber(-def.Spread, def.Spread) + basis.UpVector * rng:NextNumber(-def.Spread, def.Spread)).Unit
		local result = workspace:Raycast(origin, direction * def.Range, params)
		local finish = if result then result.Position else origin + direction * def.Range
		table.insert(segments, finish)
		local model = result and result.Instance:FindFirstAncestorOfClass("Model")
		if model and Zombies.Active[model] then
			local isHead = result.Instance.Name == "Head" or result.Instance.Name == "Olho"
			headshot = headshot or isHead
			local damage = Balance.upgradeDamage(def.Damage, record.tier) * (if isHead then 1.7 else 1)
			hits[model] = (hits[model] or 0) + damage
			anyHit = true
		end
	end
	for model, damage in hits do Zombies.damage(model, damage, player) end
	-- Send visual data only; clients cannot nominate victims or damage.
	Combat.Effects:FireAllClients("Shot", { UserId = player.UserId, Origin = origin, Ends = segments })
	if anyHit then Combat.Effects:FireClient(player, "Hit", { Head = headshot }) end
end

function Combat.start(remotes)
	Combat.Effects = remotes.Effects
	local allowFire, allowReload = Util.limiter(18, 8), Util.limiter(2, 2)
	remotes.Fire.OnServerEvent:Connect(function(player, aim) if allowFire(player) then Combat.fire(player, aim) end end)
	remotes.Reload.OnServerEvent:Connect(function(player) if allowReload(player) then Combat.reload(player) end end)
	Players.PlayerRemoving:Connect(function(player) Combat.clear(player); Combat.Inventory[player] = nil end)
end

return Combat
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX10">
        <Properties>
          <string name="Name">CommerceService</string>
          <ProtectedString name="Source">local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local Config = require(game.ReplicatedStorage.ZumbiShared.Config)
local Data = require(script.Parent.DataService)

local Commerce = { Catalog = {}, OnPassChanged = nil }
local productsById = {}

function Commerce.refreshPass(player, attempt)
	local owned = false
	if Config.VanguardPassId &gt; 0 then
		local ok, result = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Config.VanguardPassId) end)
		if not ok then
			-- A network error must not revoke a pass already verified this session.
			if player.Parent and (attempt or 1) &lt; 3 then
				task.delay(8, function() if player.Parent then Commerce.refreshPass(player, (attempt or 1) + 1) end end)
			end
			return
		end
		owned = result
	end
	if not player.Parent then return end
	player:SetAttribute("Vanguard", owned)
	if Commerce.OnPassChanged then Commerce.OnPassChanged(player) end
end

function Commerce.sendCatalog(player, remote)
	remote:FireClient(player, "Catalog", Commerce.Catalog)
end

function Commerce.start(effects, onPassChanged)
	Commerce.OnPassChanged = onPassChanged
	for _, product in Config.Products do
		assert(product.Id == 0 or not productsById[product.Id], "Developer Product IDs must be unique")
		if product.Id &gt; 0 then productsById[product.Id] = product end
	end
	MarketplaceService.ProcessReceipt = function(receipt)
		local product = productsById[receipt.ProductId]
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player or not product then return Enum.ProductPurchaseDecision.NotProcessedYet end
		if Data.receipt(player, tostring(receipt.PurchaseId), product) then
			effects:FireClient(player, "Toast", { Text = "Compra entregue e salva: " .. product.Name, Good = true })
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, id, purchased)
		if purchased and id == Config.VanguardPassId then task.spawn(Commerce.refreshPass, player) end
	end)
	task.spawn(function()
		for _, product in Config.Products do
			local entry = { Id = product.Id, Key = product.Key, Name = product.Name, Description = product.Description, Kind = "Product", Available = false }
			if product.Id &gt; 0 then
				local ok, info = pcall(function() return MarketplaceService:GetProductInfo(product.Id, Enum.InfoType.Product) end)
				if ok and info.IsForSale and info.PriceInRobux then entry.Available, entry.Price = true, info.PriceInRobux end
			end
			table.insert(Commerce.Catalog, entry)
		end
		local pass = { Id = Config.VanguardPassId, Key = "Vanguard", Name = Config.VanguardName,
			Description = "+25 vida base e +2 velocidade • permanente", Kind = "Pass", Available = false }
		if pass.Id &gt; 0 then
			local ok, info = pcall(function() return MarketplaceService:GetProductInfo(pass.Id, Enum.InfoType.GamePass) end)
			if ok and info.IsForSale and info.PriceInRobux then pass.Available, pass.Price = true, info.PriceInRobux end
		end
		table.insert(Commerce.Catalog, pass)
		effects:FireAllClients("Catalog", Commerce.Catalog)
	end)
end

return Commerce
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX11">
        <Properties>
          <string name="Name">DataService</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Balance = require(game.ReplicatedStorage.ZumbiShared.Balance)
local Config = require(game.ReplicatedStorage.ZumbiShared.Config)

local Data = { Profiles = {}, Loading = {} }
local store
local storeAvailable, storeResult = pcall(function() return DataStoreService:GetDataStore(Config.DataStoreName) end)
if storeAvailable then store = storeResult end
local session = game.JobId .. ":" .. HttpService:GenerateGUID(false)
local shuttingDown = false

local function defaults()
	return { Version = 1, Coins = Balance.StartingCoins, BestWave = 0, Wins = 0, Kills = 0,
		Skin = "Default", Skins = { Default = true }, Revives = 0, BoostUntil = 0, Receipts = {} }
end

local function copy(value)
	if type(value) ~= "table" then return value end
	local result = {}
	for key, item in value do result[key] = copy(item) end
	return result
end

local function hydrate(raw)
	local result = defaults()
	if type(raw) ~= "table" then return result end
	for key, value in result do
		if type(raw[key]) == type(value) then result[key] = copy(raw[key]) end
	end
	result.Skins.Default = true
	if not Balance.Skins[result.Skin] or not result.Skins[result.Skin] then result.Skin = "Default" end
	return result
end

function Data.sync(player)
	local p = Data.Profiles[player]
	if not p then return end
	local d = p.data
	player:SetAttribute("Coins", d.Coins)
	player:SetAttribute("Revives", d.Revives)
	player:SetAttribute("Skin", d.Skin)
	player:SetAttribute("BestWave", d.BestWave)
	player:SetAttribute("Wins", d.Wins)
	player:SetAttribute("BoostUntil", d.BoostUntil)
	player:SetAttribute("DataPersistent", p.persistent)
	for key in Balance.Skins do player:SetAttribute("Skin_" .. key, d.Skins[key] == true) end
	local stats = player:FindFirstChild("leaderstats")
	if stats then stats.Abates.Value = d.Kills; stats.Recorde.Value = d.BestWave end
end

function Data.load(player)
	if Data.Loading[player] or Data.Profiles[player] then return end
	Data.Loading[player] = true
	local loaded
	local ok, err
	for attempt = 1, 3 do
		ok, err = pcall(function()
			assert(store, "DataStore unavailable in this place")
			loaded = store:UpdateAsync("u_" .. player.UserId, function(old)
				if type(old) == "table" and old.Session and old.Session.Id ~= session and old.Session.Until &gt; os.time() then return nil end
				local d = hydrate(old)
				d.Session = { Id = session, Until = os.time() + 150 }
				return d
			end)
		end)
		if ok then break end
		if attempt &lt; 3 then task.wait(attempt) end
	end
	Data.Loading[player] = nil
	if not player.Parent then
		if ok and loaded then
			pcall(function() store:UpdateAsync("u_" .. player.UserId, function(old)
				if old and old.Session and old.Session.Id == session then old.Session = nil; return old end
				return nil
			end) end)
		end
		return
	end
	if ok and not loaded then player:Kick("Seus dados estão abertos em outro servidor. Aguarde 2 minutos e tente novamente."); return end
	if not ok and not RunService:IsStudio() then
		warn("[ZUMBI] Profile load failed; purchases disabled: " .. tostring(err))
		player:Kick("Não foi possível carregar seus dados com segurança. Tente novamente em instantes.")
		return
	end
	if not ok then warn("[ZUMBI] Studio sem DataStore: progresso temporário; compras desativadas.") end
	Data.Profiles[player] = { data = hydrate(loaded), persistent = ok, busy = false, closing = false, lastSaved = os.clock() }
	local stats = Instance.new("Folder"); stats.Name = "leaderstats"; stats.Parent = player
	for _, key in { "Abates", "Recorde" } do local v = Instance.new("IntValue"); v.Name = key; v.Parent = stats end
	Data.sync(player)
	player:SetAttribute("DataReady", true)
end

function Data.award(player, coins, kills)
	local p = Data.Profiles[player]
	if not p or p.closing then return end
	p.data.Coins += math.max(0, math.floor(coins or 0))
	p.data.Kills += math.max(0, math.floor(kills or 0))
	Data.sync(player)
end

function Data.spend(player, amount)
	local p = Data.Profiles[player]
	if not p or p.closing or amount &lt; 0 or p.data.Coins &lt; amount then return false end
	p.data.Coins -= amount
	Data.sync(player)
	return true
end

function Data.record(player, wave, won)
	local p = Data.Profiles[player]
	if not p then return end
	p.data.BestWave = math.max(p.data.BestWave, wave)
	if won then p.data.Wins += 1 end
	Data.sync(player)
end

function Data.cosmetic(player, key)
	local skin = Balance.Skins[key]
	local p = Data.Profiles[player]
	if not p or not skin then return end
	if not p.data.Skins[key] then
		if not Data.spend(player, skin.Price) then return false end
		p.data.Skins[key] = true
	end
	p.data.Skin = key
	Data.sync(player)
	return true
end

function Data.useRevive(player)
	local p = Data.Profiles[player]
	if not p or p.closing or p.data.Revives &lt; 1 then return false end
	p.data.Revives -= 1
	Data.sync(player)
	return true
end

local function lock(p)
	while p.busy do task.wait(0.05) end
	p.busy = true
end

function Data.save(player, release)
	local p = Data.Profiles[player]
	if not p then return true end
	if not p.persistent then
		if release then Data.Profiles[player] = nil end
		return true
	end
	lock(p)
	if release then p.closing = true end
	local snapshot = copy(p.data)
	snapshot.Session = if release then nil else { Id = session, Until = os.time() + 150 }
	local saved
	local ok, err = pcall(function()
		saved = store:UpdateAsync("u_" .. player.UserId, function(old)
			if not old or not old.Session or old.Session.Id ~= session then return nil end
			return snapshot
		end)
	end)
	p.busy = false
	if ok and saved then
		p.lastSaved = os.clock()
		if release then Data.Profiles[player] = nil end
		return true
	end
	warn("[ZUMBI] Save failed: " .. tostring(err or "session ownership lost"))
	if not release and os.clock() - p.lastSaved &gt; 95 then
		p.closing = true
		player:SetAttribute("DataPersistent", false)
		player:Kick("Conexão com seus dados interrompida. Reconecte para proteger seu progresso.")
	end
	return false
end

local function applyProduct(d, product)
	if product.Grant == "Coins" then d.Coins += product.Amount
	elseif product.Grant == "Revives" then d.Revives += product.Amount
	elseif product.Grant == "Boost" then d.BoostUntil = math.max(os.time(), d.BoostUntil) + product.Amount end
end

-- Acknowledge ONLY after the entitlement and receipt ID are saved atomically.
function Data.receipt(player, receiptId, product)
	local p = Data.Profiles[player]
	if not p or not p.persistent or p.closing then return false end
	lock(p)
	if p.closing then p.busy = false; return false end
	if p.data.Receipts[receiptId] then p.busy = false; return true end
	local snapshot = copy(p.data)
	local saved
	local ok = pcall(function()
		saved = store:UpdateAsync("u_" .. player.UserId, function(old)
			if not old or not old.Session or old.Session.Id ~= session then return nil end
			if old.Receipts and old.Receipts[receiptId] then return old end
			local result = copy(snapshot)
			applyProduct(result, product)
			result.Receipts[receiptId] = true
			result.Session = { Id = session, Until = os.time() + 150 }
			return result
		end)
	end)
	if ok and saved and saved.Receipts[receiptId] then
		-- Apply a delta so gameplay earnings made while UpdateAsync yielded survive.
		applyProduct(p.data, product)
		p.data.Receipts[receiptId] = true
		p.lastSaved = os.clock()
		Data.sync(player)
		p.busy = false
		return true
	end
	p.busy = false
	return false
end

function Data.start()
	Players.PlayerRemoving:Connect(function(player)
		for attempt = 1, 3 do if Data.save(player, true) then break end; task.wait(attempt) end
	end)
	task.spawn(function()
		while not shuttingDown do
			task.wait(40)
			for player in Data.Profiles do task.spawn(Data.save, player, false) end
		end
	end)
	game:BindToClose(function()
		shuttingDown = true
		local pending = 0
		for player in Data.Profiles do
			pending += 1
			task.spawn(function()
				for attempt = 1, 3 do if Data.save(player, true) then break end; task.wait(attempt) end
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending &gt; 0 and os.clock() &lt; deadline do task.wait(0.1) end
	end)
end

return Data
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12">
        <Properties>
          <string name="Name">GameService</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local Balance = require(game.ReplicatedStorage.ZumbiShared.Balance)
local Data = require(script.Parent.DataService)
local World = require(script.Parent.World)
local Util = require(script.Parent.Util)
local Combat = require(script.Parent.CombatService)
local Zombies = require(script.Parent.ZombieService)
local Commerce = require(script.Parent.CommerceService)

local Game = { Phase = "Waiting", Wave = 0, Round = 0, Spawning = {}, Remaining = 0, EndsAt = 0, WipeAt = nil,
	Repairs = {}, Mystery = {}, TrapUntil = 0, TrapCooldown = 0 }
local rng = Random.new()
local remotes, state

local function toast(player, text, good)
	remotes.Effects:FireClient(player, "Toast", { Text = text, Good = good == true })
end

local function announce(text)
	remotes.Effects:FireAllClients("Announcement", { Text = text })
end

local function publish()
	state:SetAttribute("Phase", Game.Phase)
	state:SetAttribute("Wave", Game.Wave)
	state:SetAttribute("Remaining", Game.Remaining)
	state:SetAttribute("Enemies", Zombies.count())
	state:SetAttribute("EndsAt", Game.EndsAt)
	state:SetAttribute("Power", World.Powered)
	state:SetAttribute("WipeAt", Game.WipeAt or 0)
	state:SetAttribute("Living", #Util.livingPlayers())
	state:SetAttribute("Round", Game.Round)
end

function Game.stats(player)
	local alive, hum = Util.alive(player)
	if not alive then return end
	local maxHealth = 100 + (if player:GetAttribute("Vanguard") then 25 else 0) + (if player:GetAttribute("Juggernaut") then 75 else 0)
	local delta = maxHealth - hum.MaxHealth
	hum.MaxHealth = maxHealth
	hum.Health = math.clamp(hum.Health + math.max(0, delta), 0, maxHealth)
	hum.WalkSpeed = (if player:GetAttribute("Sprinting") then Balance.SprintSpeed else Balance.BaseSpeed)
		+ (if player:GetAttribute("Runner") then 3 else 0) + (if player:GetAttribute("Vanguard") then 2 else 0)
end

local function resetPerks(player)
	for key in Balance.Perks do player:SetAttribute(key, false) end
	player:SetAttribute("RoundRevives", 0)
	player:SetAttribute("BoughtRescue", false)
	player:SetAttribute("Stamina", 100)
	player:SetAttribute("Sprinting", false)
	player:SetAttribute("RoundKills", 0)
end

function Game.spawn(player, fresh)
	if Game.Spawning[player] or not player.Parent or not player:GetAttribute("DataReady") then return end
	Game.Spawning[player] = true
	local round = Game.Round
	if fresh then resetPerks(player) end
	player:SetAttribute("InRound", false)
	Combat.clear(player)
	local ok, err = pcall(function() player:LoadCharacterAsync() end)
	if ok and player.Parent and player.Character and round == Game.Round then
		local root = player.Character:WaitForChild("HumanoidRootPart", 8)
		if root and Game.Phase ~= "GameOver" and Game.Phase ~= "Victory" then
			player.Character:PivotTo(CFrame.new(World.Spawn + Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-5, 5))))
			player:SetAttribute("InRound", true)
			player:SetAttribute("Eliminated", false)
			player:SetAttribute("InvulnerableUntil", workspace:GetServerTimeNow() + 8)
			Game.stats(player)
			local shield = Instance.new("ForceField"); shield.Visible, shield.Parent = true, player.Character
			task.delay(8, function() shield:Destroy() end)
			Combat.give(player, "Pistol")
		end
	else warn("[ZUMBI] Character spawn failed: " .. tostring(err)) end
	Game.Spawning[player] = nil
end

function Game.addPlayer(player)
	player:SetAttribute("InRound", false)
	player:SetAttribute("Eliminated", false)
	resetPerks(player)
	player.CharacterAdded:Connect(function(character)
		local hum = character:WaitForChild("Humanoid", 10)
		if not hum then return end
		local function collide(part)
			if part:IsA("BasePart") then part.CollisionGroup = "Survivors" end
		end
		for _, p in character:GetDescendants() do collide(p) end
		character.DescendantAdded:Connect(collide)
		hum.Died:Connect(function()
			if player.Character ~= character then return end
			player:SetAttribute("InRound", false)
			player:SetAttribute("Eliminated", true)
			player:SetAttribute("Sprinting", false)
			toast(player, "Eliminado. Você retorna na pausa seguinte; um resgate permite voltar agora.", false)
		end)
	end)
	Data.load(player)
	if not player.Parent or not player:GetAttribute("DataReady") then return end
	task.spawn(Commerce.refreshPass, player)
	if Game.Phase ~= "Waiting" and Game.Phase ~= "Victory" and Game.Phase ~= "GameOver" then Game.spawn(player, true) end
end

local function buy(player, cost)
	if not Data.spend(player, cost) then toast(player, "Suprimentos insuficientes • precisa de " .. cost .. " moedas."); return false end
	return true
end

function Game.interact(player, action, arg)
	if not player:GetAttribute("InRound") or not Util.alive(player) or Game.Phase == "GameOver" or Game.Phase == "Victory" then return false end
	if action == "Door" then
		if buy(player, arg.Price) then announce(player.DisplayName .. " abriu " .. arg.Name); return true end
	elseif action == "Weapon" then
		local def = Balance.Weapons[arg]
		local owned = Combat.owned(player, arg)
		local cost = if owned then Balance.refillCost(def.Price) else def.Price
		if buy(player, cost) then
			Combat.give(player, arg)
			toast(player, if owned then "Arma reabastecida." else def.Name .. " equipada!", true)
			return true
		end
	elseif action == "Ammo" then
		if not Combat.hasEquipped(player) then toast(player, "Equipe uma arma primeiro."); return false end
		if buy(player, 45) then Combat.refill(player, nil, true); toast(player, "Munição completa.", true); return true end
	elseif action == "Upgrade" then
		if not World.Powered then toast(player, "Ligue a energia na central ao norte."); return false end
		if not Combat.canUpgrade(player) then toast(player, "Equipe uma arma abaixo do nível 3."); return false end
		if buy(player, Balance.UpgradeCost) then Combat.upgrade(player); toast(player, "Arma aprimorada! +45% do dano base por nível.", true); return true end
	elseif action == "Perk" then
		if not World.Powered then toast(player, "Os buffs precisam da energia da central."); return false end
		if player:GetAttribute(arg) then toast(player, "Esse buff já está ativo nesta partida."); return false end
		if buy(player, Balance.Perks[arg].Price) then
			player:SetAttribute(arg, true); Game.stats(player)
			toast(player, Balance.Perks[arg].Name .. " ativo até o fim da partida!", true)
			return true
		end
	elseif action == "Power" then
		if World.Powered then toast(player, "A energia já está ligada."); return false end
		if buy(player, 180) then
			World.Powered = true
			World.PowerPanel.Color = Color3.fromRGB(80, 255, 170)
			announce("ENERGIA RESTAURADA • buffs, aprimoramento e armadilha disponíveis")
			publish(); return true
		end
	elseif action == "Heal" then
		local _, hum = Util.alive(player)
		if hum.Health &gt;= hum.MaxHealth then toast(player, "Sua vida está completa."); return false end
		if buy(player, 60) then hum.Health = hum.MaxHealth; toast(player, "Vida recuperada.", true); return true end
	elseif action == "RoundRevive" then
		if player:GetAttribute("BoughtRescue") then toast(player, "Você já comprou o resgate desta partida."); return false end
		if buy(player, 90) then
			player:SetAttribute("BoughtRescue", true)
			player:SetAttribute("RoundRevives", (player:GetAttribute("RoundRevives") or 0) + 1)
			toast(player, "Resgate pronto. Use o botão RESGATAR quando for eliminado.", true)
			return true
		end
	elseif action == "Loot" then
		local _, hum = Util.alive(player)
		local roll = rng:NextInteger(1, 3)
		if roll == 1 then Combat.refill(player, nil, false); toast(player, "Suprimentos: munição +25 moedas", true); Data.award(player, 25)
		elseif roll == 2 then hum.Health = math.min(hum.MaxHealth, hum.Health + 45); Data.award(player, 25); toast(player, "Suprimentos: cura +25 moedas", true)
		else Data.award(player, 65); toast(player, "Suprimentos: +65 moedas", true) end
		return true
	elseif action == "Mystery" then
		if Game.Mystery[player] == Game.Wave then toast(player, "Resgate gratuito já usado nesta horda."); return false end
		Game.Mystery[player] = Game.Wave
		local pool = { "Pistol", "SMG", "Shotgun", "Rifle" }
		local id = pool[rng:NextInteger(1, #pool)]
		Combat.give(player, id)
		toast(player, "Resgate gratuito: " .. Balance.Weapons[id].Name .. " • 25% cada arma", true)
		return true
	elseif action == "Repair" then
		Game.Repairs[player] = Game.Repairs[player] or {}
		if Game.Repairs[player][arg] == Game.Wave then toast(player, "Barricada reparada nesta horda."); return false end
		Game.Repairs[player][arg] = Game.Wave
		Data.award(player, 20); toast(player, "Barricada reforçada • +20 moedas", true)
		return true
	elseif action == "Trap" then
		local now = workspace:GetServerTimeNow()
		if not World.Powered then toast(player, "Ligue a energia primeiro."); return false end
		if Game.TrapCooldown &gt; now then toast(player, "Armadilha recarregando • " .. math.ceil(Game.TrapCooldown - now) .. "s"); return false end
		if buy(player, 80) then
			Game.TrapUntil, Game.TrapCooldown = now + 12, now + 50
			remotes.Effects:FireAllClients("Trap", { Position = Vector3.new(0, 1, -18), Duration = 12 })
			return true
		end
	end
	return false
end

local function onKill(z)
	local killer = z.killer
	if killer and killer.Parent then
		local boosted = (killer:GetAttribute("BoostUntil") or 0) &gt; os.time()
		local reward = Balance.killReward(Game.Wave, boosted) * (if z.boss then 6 else 1)
		Data.award(killer, reward, 1)
		killer:SetAttribute("RoundKills", (killer:GetAttribute("RoundKills") or 0) + 1)
		remotes.Effects:FireClient(killer, "Kill", { Coins = reward, Boss = z.boss })
	end
	for player in z.hits do if player ~= killer and player.Parent then Data.award(player, Balance.AssistCoins) end end
	if rng:NextNumber() &lt; 0.17 then World.drop(z.root.Position, function(player) Combat.refill(player, nil, false) end) end
end

local function loadedPlayers()
	local result = {}
	for _, player in Players:GetPlayers() do if player:GetAttribute("DataReady") then table.insert(result, player) end end
	return result
end

local function hasSurvivors()
	if #loadedPlayers() == 0 then return false end
	if #Util.livingPlayers() &gt; 0 or next(Game.Spawning) then Game.WipeAt = nil; return true end
	if not Game.WipeAt then Game.WipeAt = workspace:GetServerTimeNow() + 8; announce("EQUIPE ELIMINADA • 8 segundos para usar um resgate") end
	return workspace:GetServerTimeNow() &lt; Game.WipeAt
end

local function phase(name, duration)
	Game.Phase, Game.EndsAt, Game.WipeAt = name, workspace:GetServerTimeNow() + (duration or 0), nil
	publish()
end

local function prep(initial)
	phase("Preparation", if initial then Balance.InitialPrep else Balance.BetweenWaves)
	Game.Repairs, Game.Mystery = {}, {}
	World.resetLoot()
	for _, player in loadedPlayers() do
		if not player:GetAttribute("InRound") or initial then task.spawn(Game.spawn, player, initial) end
		local alive, hum = Util.alive(player)
		if alive then hum.Health = hum.MaxHealth end
	end
	announce(if initial then "VOO 813 CAIU • explore, encontre armas e prepare a defesa" else "HORDA CONCLUÍDA • cure-se, reabasteça e prepare-se")
	if initial then World.crash() end
	while workspace:GetServerTimeNow() &lt; Game.EndsAt do
		if #loadedPlayers() == 0 then return false end
		publish(); task.wait(0.4)
	end
	return true
end

local function runWave(wave)
	Game.Wave = wave
	local settings = Balance.wave(wave, #loadedPlayers())
	Game.Remaining = settings.Count + (if settings.Boss then 1 else 0)
	Game.Repairs, Game.Mystery = {}, {}
	World.resetLoot()
	phase("Wave", 0)
	announce("HORDA " .. wave .. (if settings.Boss then " • O COMANDANTE CHEGOU" else " • DEFENDAM A CIDADE"))
	if settings.Boss then Zombies.spawn(settings, true); Game.Remaining -= 1 end
	local nextSpawn = 0
	while Game.Remaining &gt; 0 or Zombies.count() &gt; 0 do
		if not hasSurvivors() then return false end
		if os.clock() &gt;= nextSpawn and Game.Remaining &gt; 0 and Zombies.count() &lt; Balance.MaxLivingZombies then
			local spawned = Zombies.spawn(settings, false)
			if spawned then Game.Remaining -= 1 end
			nextSpawn = os.clock() + settings.SpawnInterval
		end
		publish(); task.wait(0.2)
	end
	for _, player in loadedPlayers() do Data.award(player, Balance.WaveCoins + wave * 3); Data.record(player, wave, false) end
	return true
end

local function extract()
	phase("Extraction", Balance.ExtractionTime)
	World.extraction()
	announce("RESGATE A CAMINHO • alcance o heliponto junto ao avião antes do cronômetro zerar")
	remotes.Effects:FireAllClients("Waypoint", { Position = World.Extraction })
	local nextSpawn = 0
	while workspace:GetServerTimeNow() &lt; Game.EndsAt do
		if not hasSurvivors() then return false end
		if os.clock() &gt; nextSpawn and Zombies.count() &lt; 18 then
			Zombies.spawn(Balance.wave(Balance.FinalWave, #loadedPlayers()), false)
			nextSpawn = os.clock() + 1.4
		end
		publish(); task.wait(0.25)
	end
	local winners = 0
	for _, player in Util.livingPlayers() do
		local _, _, root = Util.alive(player)
		local delta = root.Position - World.Extraction
		if math.abs(delta.X) &lt;= 16 and math.abs(delta.Z) &lt;= 16 and root.Position.Y &lt; 25 then
			winners += 1
			Data.award(player, Balance.ExtractionCoins)
			Data.record(player, Balance.FinalWave, true)
			toast(player, "EXTRAÍDO! +300 moedas • vitória salva", true)
		else toast(player, "O helicóptero partiu sem você. Alcance a zona verde na próxima tentativa.") end
	end
	return winners &gt; 0
end

function Game.start(remoteFolder, stateFolder)
	remotes, state = remoteFolder, stateFolder
	World.build(Game.interact)
	Zombies.init(onKill)
	Combat.start(remotes)
	Data.start()
	Commerce.start(remotes.Effects, Game.stats)
	local allowAction = Util.limiter(5, 8)
	remotes.Action.OnServerEvent:Connect(function(player, action, arg)
		if not allowAction(player) or type(action) ~= "string" then return end
		if action == "Ready" then Commerce.sendCatalog(player, remotes.Effects); return end
		if not player:GetAttribute("DataReady") then return end
		if action == "Skin" and type(arg) == "string" and #arg &lt; 30 then
			if Data.cosmetic(player, arg) then Combat.recolor(player); toast(player, "Acabamento equipado!", true)
			else toast(player, "Moedas insuficientes ou acabamento inválido.") end
		elseif action == "Sprint" and type(arg) == "boolean" then
			player:SetAttribute("Sprinting", arg and player:GetAttribute("InRound") and (player:GetAttribute("Stamina") or 0) &gt; 5)
			Game.stats(player)
		elseif action == "Revive" then
			if Game.Phase ~= "Wave" and Game.Phase ~= "Extraction" then toast(player, "Você retorna automaticamente na próxima preparação."); return end
			if player:GetAttribute("InRound") or Game.Spawning[player] then return end
			local tokens = player:GetAttribute("RoundRevives") or 0
			if tokens &gt; 0 then player:SetAttribute("RoundRevives", tokens - 1)
			elseif not Data.useRevive(player) then toast(player, "Sem resgates. Há um reanimador por moedas na igreja."); return end
			-- Invalidate the wipe timer immediately; spawning may yield for avatar loading.
			Game.WipeAt = nil
			task.spawn(Game.spawn, player, false)
		end
	end)
	Players.PlayerAdded:Connect(function(player) task.spawn(Game.addPlayer, player) end)
	Players.PlayerRemoving:Connect(function(player)
		Game.Spawning[player], Game.Repairs[player], Game.Mystery[player] = nil, nil, nil
	end)
	for _, player in Players:GetPlayers() do task.spawn(Game.addPlayer, player) end
	-- Server stamina and electric trap updates do not depend on client frame rate.
	task.spawn(function()
		while true do
			for _, player in Players:GetPlayers() do
				local alive, hum, root = Util.alive(player)
				if alive then
					local stamina = player:GetAttribute("Stamina") or 100
					local velocity = root.AssemblyLinearVelocity
					local running = player:GetAttribute("Sprinting") and Vector3.new(velocity.X, 0, velocity.Z).Magnitude &gt; 3
					stamina = math.clamp(stamina + (if running then -4 else 2.8), 0, 100)
					player:SetAttribute("Stamina", stamina)
					if stamina &lt;= 0 and player:GetAttribute("Sprinting") then player:SetAttribute("Sprinting", false); Game.stats(player) end
				end
			end
			if workspace:GetServerTimeNow() &lt; Game.TrapUntil then
				for model, z in Zombies.Active do
					if (z.root.Position - Vector3.new(0, 2, -18)).Magnitude &lt; 25 then Zombies.damage(model, 18, nil) end
				end
			end
			task.wait(0.2)
		end
	end)
	task.spawn(function()
		while true do
			phase("Waiting", 0)
			while #loadedPlayers() == 0 do task.wait(1) end
			Game.Round += 1
			Game.Wave, Game.Remaining, Game.TrapUntil, Game.TrapCooldown = 0, 0, 0, 0
			Zombies.clear(); World.reset()
			local completed = prep(true)
			if completed then
				for wave = 1, Balance.FinalWave do
					if not runWave(wave) then completed = false; break end
					if wave &lt; Balance.FinalWave and not prep(false) then completed = false; break end
				end
			end
			local won = completed and extract()
			Zombies.clear()
			phase(if won then "Victory" else "GameOver", 15)
			announce(if won then "ÚLTIMO VOO • SOBREVIVENTES EXTRAÍDOS" else "A CIDADE CAIU • REAGRUPANDO EM 15 SEGUNDOS")
			for _, player in loadedPlayers() do
				player:SetAttribute("InRound", false)
				task.spawn(Data.save, player, false)
			end
			task.wait(15)
		end
	end)
end

return Game
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX13">
        <Properties>
          <string name="Name">Util</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local Util = {}

function Util.folder(parent, name)
	local found = parent:FindFirstChild(name)
	if found then return found end
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = name, parent
	return folder
end

function Util.alive(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return hum and hum.Health &gt; 0 and root ~= nil, hum, root
end

function Util.finiteVector(v)
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z
		and math.abs(v.X) &lt; 10000 and math.abs(v.Y) &lt; 10000 and math.abs(v.Z) &lt; 10000
end

function Util.near(player, position, distance)
	local alive, _, root = Util.alive(player)
	return alive and (root.Position - position).Magnitude &lt;= distance
end

function Util.livingPlayers()
	local result = {}
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("InRound") and Util.alive(player) then table.insert(result, player) end
	end
	return result
end

-- Token buckets are per player AND action. No yielding occurs during acceptance.
function Util.limiter(rate, burst)
	local buckets = setmetatable({}, { __mode = "k" })
	return function(player)
		local now = os.clock()
		local b = buckets[player] or { tokens = burst, at = now }
		b.tokens = math.min(burst, b.tokens + (now - b.at) * rate)
		b.at = now
		buckets[player] = b
		if b.tokens &lt; 1 then return false end
		b.tokens -= 1
		return true
	end
end

return Util
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX14">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Util = require(script.Parent.Util)

local World = { Spawn = Vector3.new(0, 4, 80), Extraction = Vector3.new(0, 0.4, 132), Doors = {}, Loot = {}, Powered = false }
local rng = Random.new(8137)
local palette = { concrete = Color3.fromRGB(67, 73, 77), brick = Color3.fromRGB(103, 72, 62), wood = Color3.fromRGB(91, 71, 51), glow = Color3.fromRGB(100, 230, 210) }

local function part(parent, name, size, cf, color, material)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame, p.Color = name, size, cf, color
	p.Anchored, p.TopSurface, p.BottomSurface = true, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Material = material or Enum.Material.Concrete
	p.Parent = parent
	return p
end

local function label(anchor, text, color, size)
	local gui = Instance.new("BillboardGui")
	gui.Name, gui.Size, gui.StudsOffset = "Sign", UDim2.fromOffset(size or 240, 62), Vector3.new(0, 3, 0)
	gui.MaxDistance, gui.AlwaysOnTop, gui.Parent = 115, false, anchor
	local t = Instance.new("TextLabel")
	t.Size, t.BackgroundTransparency, t.Text = UDim2.fromScale(1, 1), 0.2, text
	t.BackgroundColor3, t.TextColor3, t.TextSize = Color3.fromRGB(13, 20, 23), color or Color3.fromRGB(235, 233, 216), 17
	t.Font, t.TextWrapped, t.Parent = Enum.Font.GothamBold, true, gui
	Instance.new("UICorner", t).CornerRadius = UDim.new(0, 5)
	return gui
end

function World.prompt(anchor, action, object, callback, duration)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.ObjectText = action, object
	prompt.MaxActivationDistance, prompt.HoldDuration = 10, duration or 0.35
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.RequiresLineOfSight, prompt.Parent = false, anchor
	local accept = Util.limiter(2, 2)
	prompt.Triggered:Connect(function(player)
		if prompt.Enabled and player:GetAttribute("InRound") and accept(player) and Util.near(player, anchor.Position, 13) then callback(player, prompt) end
	end)
	return prompt
end

local function lamp(parent, pos, color)
	part(parent, "Poste", Vector3.new(0.6, 16, 0.6), CFrame.new(pos + Vector3.new(0, 8, 0)), palette.concrete, Enum.Material.Metal)
	local bulb = part(parent, "Luz", Vector3.new(3, 0.4, 3), CFrame.new(pos + Vector3.new(0, 16, 0)), color, Enum.Material.Neon)
	local light = Instance.new("PointLight"); light.Color, light.Range, light.Brightness, light.Parent = color, 34, 1.5, bulb
end

local function furnishing(parent, kind, pos)
	local cf = CFrame.new(pos)
	if kind == "bench" then
		part(parent, "Banco", Vector3.new(12, 0.7, 3), cf * CFrame.new(0, 2, 0), palette.wood, Enum.Material.WoodPlanks)
		part(parent, "Encosto", Vector3.new(12, 3, 0.6), cf * CFrame.new(0, 3, -1.3), palette.wood, Enum.Material.WoodPlanks)
		for _, x in { -5, 5 } do part(parent, "Pé", Vector3.new(0.6, 2, 2), cf * CFrame.new(x, 1, 0), palette.concrete, Enum.Material.Metal) end
	elseif kind == "desk" then
		part(parent, "Mesa", Vector3.new(10, 0.7, 5), cf * CFrame.new(0, 3, 0), palette.wood, Enum.Material.WoodPlanks)
		for _, x in { -4, 4 } do part(parent, "Suporte", Vector3.new(0.7, 3, 4), cf * CFrame.new(x, 1.5, 0), palette.concrete) end
		part(parent, "Terminal", Vector3.new(3, 2, 0.5), cf * CFrame.new(0, 4.3, -1), Color3.fromRGB(30, 85, 80), Enum.Material.Neon)
	elseif kind == "bed" then
		part(parent, "Maca", Vector3.new(5, 1, 9), cf * CFrame.new(0, 2.6, 0), Color3.fromRGB(170, 190, 180), Enum.Material.Fabric)
		part(parent, "Base", Vector3.new(4, 2, 8), cf * CFrame.new(0, 1, 0), palette.concrete, Enum.Material.Metal)
	end
end

local function building(name, center, width, depth, height, color, locked, price, callback)
	local model = Instance.new("Model"); model.Name, model.Parent = name, World.Map
	local cf = CFrame.new(center)
	part(model, "Piso", Vector3.new(width, 0.4, depth), cf, Color3.fromRGB(92, 91, 83), Enum.Material.Slate)
	-- Front wall has a real, 12-stud-wide entrance. Side windows have actual openings.
	for _, s in { -1, 1 } do
		part(model, "Fachada", Vector3.new((width - 12) / 2, height, 1.2), cf * CFrame.new(s * (width + 12) / 4, height / 2, depth / 2), color)
		part(model, "JanelaBase", Vector3.new(1.2, 4, depth), cf * CFrame.new(s * width / 2, 2, 0), color)
		part(model, "JanelaTopo", Vector3.new(1.2, height - 9, depth), cf * CFrame.new(s * width / 2, 9 + (height - 9) / 2, 0), color)
		for z = -depth / 2, depth / 2, 14 do part(model, "Coluna", Vector3.new(1.4, 5, 2.5), cf * CFrame.new(s * width / 2, 6.5, z), color) end
	end
	part(model, "Portal", Vector3.new(12, height - 10, 1.2), cf * CFrame.new(0, 10 + (height - 10) / 2, depth / 2), color)
	part(model, "ParedeFundo", Vector3.new(width, height, 1.2), cf * CFrame.new(0, height / 2, -depth / 2), color)
	part(model, "Telhado", Vector3.new(width + 3, 1.2, depth + 3), cf * CFrame.new(0, height + 0.6, 0), Color3.fromRGB(36, 43, 46), Enum.Material.Slate)
	local sign = part(model, "Placa", Vector3.new(math.min(width - 4, 30), 3, 0.7), cf * CFrame.new(0, 12, depth / 2 + 1), palette.concrete)
	label(sign, string.upper(name), palette.glow)
	local light = Instance.new("PointLight"); light.Range, light.Brightness, light.Color, light.Parent = 55, 1.3, Color3.fromRGB(220, 205, 160), sign
	if locked then
		local door = part(model, "Porta", Vector3.new(12, 10, 1), cf * CFrame.new(0, 5, depth / 2), palette.wood, Enum.Material.WoodPlanks)
		local d = { part = door, cf = door.CFrame, open = false }
		d.prompt = World.prompt(door, "Desbloquear • " .. price .. " moedas", name, function(player)
			if d.open then return end
			if callback(player, "Door", { Price = price, Name = name }) then
				d.open, d.prompt.Enabled = true, false
				door.CanCollide = false
				TweenService:Create(door, TweenInfo.new(0.7), { CFrame = d.cf * CFrame.new(0, 11, 0), Transparency = 0.7 }):Play()
			end
		end)
		table.insert(World.Doors, d)
	end
	return model
end

local function station(parent, pos, title, action, kind, arg, callback, color)
	local p = part(parent, title, Vector3.new(4, 5, 3), CFrame.new(pos + Vector3.new(0, 2.5, 0)), color or palette.glow, Enum.Material.Metal)
	part(parent, "Painel", Vector3.new(3.3, 1.7, 0.15), p.CFrame * CFrame.new(0, 0.8, 1.6), palette.glow, Enum.Material.Neon)
	label(p, title)
	World.prompt(p, action, title, function(player) callback(player, kind, arg) end)
	return p
end

local function plane(parent, cf)
	local m = Instance.new("Model"); m.Name, m.Parent = "Voo 813", parent
	part(m, "Fuselagem", Vector3.new(10, 9, 50), cf, Color3.fromRGB(178, 183, 172), Enum.Material.Metal)
	part(m, "Faixa", Vector3.new(10.1, 1.3, 45), cf * CFrame.new(0, 1, 0), Color3.fromRGB(41, 118, 114), Enum.Material.Metal)
	part(m, "Asas", Vector3.new(68, 1, 13), cf * CFrame.new(0, -2, 1), Color3.fromRGB(117, 128, 134), Enum.Material.Metal)
	part(m, "Cauda", Vector3.new(2, 17, 10), cf * CFrame.new(0, 7, 20), Color3.fromRGB(57, 105, 108), Enum.Material.Metal)
	for _, x in { -19, 19 } do
		local engine = part(m, "Motor", Vector3.new(6, 6, 12), cf * CFrame.new(x, -4, -2), palette.concrete, Enum.Material.Metal)
		engine.Shape = Enum.PartType.Cylinder
	end
	for z = -18, 14, 6 do
		for _, x in { -5.1, 5.1 } do part(m, "Janela", Vector3.new(0.15, 2, 2), cf * CFrame.new(x, 1.7, z), Color3.fromRGB(28, 46, 52), Enum.Material.Glass) end
	end
	return m
end

function World.build(callback)
	local previous = workspace:FindFirstChild("ZumbiWorld"); if previous then previous:Destroy() end
	World.Map = Instance.new("Folder"); World.Map.Name, World.Map.Parent = "ZumbiWorld", workspace
	World.Enemies = Util.folder(workspace, "ZumbiEnemies")
	World.Drops = Util.folder(workspace, "ZumbiDrops")
	Lighting.ClockTime, Lighting.Brightness = 0.6, 2
	Lighting.Ambient, Lighting.OutdoorAmbient = Color3.fromRGB(69, 85, 100), Color3.fromRGB(85, 100, 115)
	Lighting.FogColor, Lighting.FogStart, Lighting.FogEnd = Color3.fromRGB(32, 53, 60), 120, 480
	local atmosphere = Instance.new("Atmosphere"); atmosphere.Density, atmosphere.Haze, atmosphere.Color, atmosphere.Parent = 0.25, 1.5, Color3.fromRGB(141, 166, 163), Lighting
	part(World.Map, "Terreno", Vector3.new(550, 4, 550), CFrame.new(0, -2, 0), Color3.fromRGB(45, 58, 48), Enum.Material.Grass)
